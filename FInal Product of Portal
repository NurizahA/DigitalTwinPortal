<script>
const sites=['Anacortes','Canton','Catlettsburg','Detroit','Dickinson','El Paso','Galveston Bay','Garyville','Kenai','Los Angeles','Mandan','Robinson','Salt Lake City'];
const siteMetrics={Anacortes:{rate:79,searches:944},Canton:{rate:73,searches:1117},Catlettsburg:{rate:75,searches:1088},Detroit:{rate:76,searches:1207},Dickinson:{rate:78,searches:1202},'El Paso':{rate:58,searches:1048},'Galveston Bay':{rate:80,searches:1315},Garyville:{rate:64,searches:758},Kenai:{rate:73,searches:989},'Los Angeles':{rate:69,searches:1035},Mandan:{rate:71,searches:1058},Robinson:{rate:94,searches:1407},'Salt Lake City':{rate:68,searches:1175}};
