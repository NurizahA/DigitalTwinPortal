let seed=20260922;function rnd(){seed=(seed*1664525+1013904223)%4294967296;return seed/4294967296}function pick(a){return a[Math.floor(rnd()*a.length)]}
let records=[],directoryRecords=[];const first=['Avery','Jordan','Taylor','Morgan','Casey','Riley','Cameron','Parker','Skyler','Quinn','Reese','Rowan'];const last=['Adams','Brooks','Clark','Davis','Evans','Foster','Garcia','Hayes','Jones','Kim','Lewis','Moore'];
sites.forEach((site,si)=>{let n=14+(si%7);for(let i=1;i<=n;i++){let fn=pick(first),ln=pick(last),id=String(810000+si*100+i),trained=rnd()>.23,completion=trained?pick(weeks):'',manager='Demo Manager '+(1+si%5),email=`demo.${site.toLowerCase().replace(/[^a-z]/g,'')}.${String(i).padStart(2,'0')}@example.com`;weeks.forEach(w=>{let active=rnd()<(trained?.72:.18),searches=active?1+Math.floor(rnd()*18):0,canvases=active&&rnd()>.72?1+Math.floor(rnd()*3):0;records.push({EmployeeID:id,EmployeeName:`${fn} ${ln}`,Email:email,Manager:manager,ManagerEmail:`manager${1+si%5}@example.com`,Refinery:site,BusinessUnit:'Refining',TrainingStatus:trained?'Complete':'Open',CompletionDate:completion,Week:w,MonthlyActive:active||rnd()>.55?1:0,WeeklyActive:active?1:0,Searches:searches,Canvases:canvases})})}});
let selectedSite='All Refineries',query='';const $=id=>document.getElementById(id),uniq=a=>[...new Set(a)],fmt=n=>Number(n).toLocaleString();
function init(){ $('sites').innerHTML=['All Refineries',...sites].map(s=>`<button class="site ${s===selectedSite?'active':''}" data-site="${s}">${s}</button>`).join('');$('week').innerHTML='<option>All Weeks</option>'+weeks.map(w=>`<option>${w}</option>`).join('');document.querySelectorAll('.site').forEach(b=>b.onclick=()=>{selectedSite=b.dataset.site;initSitesOnly();render()});document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));b.classList.add('active');$(b.dataset.view).classList.add('active')})}
