function filtered(){let tf=$('trainingFilter').value,w=$('week').value;return records.filter(r=>(selectedSite==='All Refineries'||r.Refinery===selectedSite)&&(w==='All Weeks'||r.Week===w)&&(tf==='All'||r.TrainingStatus===tf)&&(!query||(`${r.EmployeeName} ${r.Email}`).toLowerCase().includes(query)))}
